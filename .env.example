# Optional. Google Maps JavaScript API key with the Geocoding API enabled.
# When set, "Use my current location" fills the pickup field with a street
# address. When unset, the field is filled with latitude/longitude instead.
# Restrict the key to your site's HTTP referrers in Google Cloud Console:
# it is embedded in the client bundle and visible to anyone.
VITE_GOOGLE_MAPS_API_KEY=
